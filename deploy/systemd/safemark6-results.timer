[Unit]
Description=Check for new SafeMark6 results after draw time

[Timer]
OnCalendar=*-*-* 06:00:00 Asia/Hong_Kong
OnCalendar=*-*-* 21:30:00 Asia/Hong_Kong
OnCalendar=*-*-* 21:45:00 Asia/Hong_Kong
OnCalendar=*-*-* 22:00:00 Asia/Hong_Kong
OnCalendar=*-*-* 22:15:00 Asia/Hong_Kong
OnCalendar=*-*-* 22:30:00 Asia/Hong_Kong
OnCalendar=*-*-* 22:45:00 Asia/Hong_Kong
OnCalendar=*-*-* 23:00:00 Asia/Hong_Kong
Persistent=true
RandomizedDelaySec=30
Unit=safemark6-results.service

[Install]
WantedBy=timers.target
